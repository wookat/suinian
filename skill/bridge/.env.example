# 碎念后端地址（Cloudflare Workers 部署地址或本地 mock：http://localhost:8788）
SUINIAN_API_URL=http://localhost:8788
# 后端 Bearer token（mock 默认 test-token）
SUINIAN_TOKEN=test-token
# 可选
LOG_LEVEL=info
REPLY_INTERVAL_MS=3000
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
# 微信凭证目录（默认 ~/.wechatbot；Docker 内为 /data/wechatbot）
# WECHATBOT_STORAGE_DIR=
